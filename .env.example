# ──────────────────────────────────────────
# Application
# ──────────────────────────────────────────
APP_NAME=GraphSearchNeo4j
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
# When true (default), create/activate a default Domain if none is active (avoids 404 on /domains/active).
DOMAIN_AUTO_BOOTSTRAP=true
DEFAULT_DOMAIN_KEY=default
DEFAULT_DOMAIN_NAME=默认领域

# ──────────────────────────────────────────
# Neo4j
# ──────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password_here
NEO4J_DATABASE=neo4j

# ──────────────────────────────────────────
# OpenAI (LLM for entity extraction)
# ──────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ──────────────────────────────────────────
# Embedding Model (Local)
# ──────────────────────────────────────────
EMBEDDING_MODEL_PATH=./model_files/embeddingmodel/m3e-large
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu

# ──────────────────────────────────────────
# Retrieval
# ──────────────────────────────────────────
VECTOR_TOP_K=10
GRAPH_TRAVERSAL_DEPTH=2

# ──────────────────────────────────────────
# Extraction
# ──────────────────────────────────────────
EXTRACTION_MAX_CONCURRENCY=5
EXTRACTION_MAX_RETRIES=2
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ──────────────────────────────────────────
# Simulation (Social Simulation)
# ──────────────────────────────────────────
SIMULATION_MAX_AGENTS=50
SIMULATION_MEMORY_DECAY_RATE=0.1
SIMULATION_INTERACTION_PROBABILITY=0.3
SIMULATION_PLATFORM_SYNC_INTERVAL=60
SIMULATION_SIMULATION_SPEED=1.0
SIMULATION_ENABLE_EMOTION=true
SIMULATION_ENABLE_MEMORY_FORMATION=true
SIMULATION_ENABLE_RELATIONSHIP_EVOLUTION=true
